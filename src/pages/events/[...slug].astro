---
import { getCollection, render } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro';
export async function getStaticPaths() { return (await getCollection('events')).map(entry => ({ params: { slug: entry.id }, props: { entry } })); }
const { entry } = Astro.props; const { Content } = await render(entry); const date = new Intl.DateTimeFormat('en-US',{weekday:'long',month:'long',day:'numeric',year:'numeric'}).format(entry.data.date);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout title={entry.data.title}><article class="section"><div class="shell prose"><p><a href={`${base}events`}>← Back to events</a></p><p class="eyebrow">{entry.data.status === 'cancelled' ? 'Cancelled event' : 'Event'}</p><h1>{entry.data.title}</h1><p class="lede">{entry.data.summary}</p><dl class="meta"><dt>Date</dt><dd><time datetime={entry.data.date.toISOString()}>{date}</time></dd><dt>Time</dt><dd>{entry.data.startTime}{entry.data.endTime ? `–${entry.data.endTime}` : ''}</dd><dt>Location</dt><dd>{entry.data.location}</dd>{entry.data.accessibilityNotes && <><dt>Access notes</dt><dd>{entry.data.accessibilityNotes}</dd></>}</dl>{entry.data.registrationUrl && <p><a class="button" href={entry.data.registrationUrl}>{entry.data.registrationLabel || `Register for ${entry.data.title}`}</a></p>}<Content /></div></article></BaseLayout>
