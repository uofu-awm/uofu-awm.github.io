---
import { getCollection } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import EventCard from '../../components/EventCard.astro';
const today = new Date(); const all = await getCollection('events'); const upcoming = all.filter(({data}) => data.status === 'upcoming' && data.date >= today).sort((a,b) => a.data.date.valueOf() - b.data.date.valueOf()); const past = all.filter(({data}) => data.status === 'past' || data.date < today).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout title="Events" description="Upcoming AWM events at the University of Utah."><section class="section"><div class="shell"><p class="kicker">Get involved</p><h1>Events</h1><p class="lede">Socials, study time, speakers, workshops, and community events. Everyone is welcome unless an event says otherwise.</p><h2>Upcoming events</h2>{upcoming.length ? <div class="grid two">{upcoming.map(event => <EventCard event={event} />)}</div> : <p>No upcoming events are posted right now. <a href={`${base}join`}>Write to the chapter</a> if you have a question.</p>}{past.length > 0 && <><h2>Past events</h2><div class="grid two">{past.map(event => <EventCard event={event} />)}</div></>}<aside class="card" aria-labelledby="calendar-archive"><h2 id="calendar-archive">Calendar archive</h2><p>Every calendar published on the original site—from Fall 2011 through Spring 2025—is preserved in the archive with its event text, dates, times, and locations.</p><a class="text-link" href={`${base}archive`}>Browse the calendar archive <span aria-hidden="true">→</span></a></aside></div></section></BaseLayout>
