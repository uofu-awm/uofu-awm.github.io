---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
const today = new Date();
const events = (await getCollection('events')).filter(({ data }) => data.status === 'upcoming' && data.date >= today).sort((a,b) => a.data.date.valueOf() - b.data.date.valueOf()).slice(0, 3);
const announcements = (await getCollection('announcements')).filter(({ data }) => !data.expires || data.expires >= today).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 2);
const programs = (await getCollection('programs')).sort((a,b) => a.data.order - b.data.order).slice(0, 3);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout title="AWM at the U">
  <section class="hero"><div class="shell hero-grid"><div><p class="kicker">University of Utah AWM</p><h1>Mission Statement</h1><p class="lede">The AWM (Association for Women in Mathematics) chapter at the University of Utah aims to foster a community in which people of all backgrounds and identities feel welcome and supported in their mathematical pursuits. <br /> We organize events for the entire campus community, including undergraduate students, graduate students, postdoctoral scholars, faculty, and staff. These include social events, an undergraduate mentoring program, outreach to local schools, and a speaker series that brings mathematicians from across the United States to our department to share their experiences.</p><a class="button" href={`${base}join`}>Come say hi</a><a class="button secondary" href={`${base}events`}>Events and past events</a></div></div></section>
  <section class="section"><div class="shell"><div class="section-heading"><h2>Coming up</h2><a href={`${base}events`}>All events <span aria-hidden="true">→</span></a></div>{events.length ? <div class="grid">{events.map(event => <EventCard event={event} />)}</div> : <p>No upcoming events are posted right now. See the <a href={`${base}events`}>chapter’s past events</a>, or <a href={`${base}join`}>write to AWM</a> to ask what is happening.</p>}</div></section>
  <section class="section alt"><div class="shell"><div class="section-heading"><h2>From the chapter</h2><a href={`${base}about#announcements`}>Chapter notes <span aria-hidden="true">→</span></a></div><div class="grid two">{announcements.map(item => <article class="card"><p class="eyebrow"><time datetime={item.data.date.toISOString()}>{item.data.date.toLocaleDateString('en-US', {month:'long', day:'numeric', year:'numeric'})}</time></p><h3>{item.data.title}</h3><p>{item.data.summary}</p>{item.data.link && <a class="text-link" href={item.data.link}>{item.data.linkLabel || 'Learn more'} <span aria-hidden="true">→</span></a>}</article>)}</div></div></section>
  <section class="section"><div class="shell"><div class="section-heading"><h2>Ways to connect</h2><a href={`${base}programs`}>Explore all programs <span aria-hidden="true">→</span></a></div><div class="grid">{programs.map(program => <article class="card"><p class="eyebrow">{program.data.audience}</p><h3><a href={`${base}programs/${program.id}/`}>{program.data.title}</a></h3><p>{program.data.summary}</p></article>)}</div></div></section>
</BaseLayout>
