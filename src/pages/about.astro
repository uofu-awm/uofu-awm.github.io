---
import { getCollection } from 'astro:content'; import BaseLayout from '../layouts/BaseLayout.astro'; const officers = (await getCollection('officers')).sort((a,b)=>a.data.order-b.data.order); const announcements=(await getCollection('announcements')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<BaseLayout title="About AWM"><section class="section"><div class="shell"><div class="prose"></div><section id="announcements" aria-labelledby="announcements-heading"><h2 id="announcements-heading">Chapter Notes Archives</h2><div class="grid two">{announcements.map(item => <article class="card"><p class="eyebrow"><time datetime={item.data.date.toISOString()}>{item.data.date.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'})}</time></p><h3>{item.data.title}</h3><p>{item.data.summary}</p>{item.data.link && <a href={item.data.link}>{item.data.linkLabel || 'Learn more'}</a>}</article>)}</div></section><section aria-labelledby="officers"><h2 id="officers">Current Officers (2026-2027)</h2><div class="grid three">{officers.map(officer => <article class="card"><h3>{officer.data.name}</h3><p class="eyebrow">{officer.data.role}</p>{officer.data.pronouns && <p>{officer.data.pronouns}</p>}{officer.data.term && <p class="meta">Term: {officer.data.term}</p>}{officer.data.email && <p><a href={`mailto:${officer.data.email}`}>Email {officer.data.name}</a></p>}</article>)}</div></section></div></section></BaseLayout>
